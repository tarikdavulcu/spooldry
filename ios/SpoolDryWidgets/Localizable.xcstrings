    "Last update %@ ago. The dryer keeps running safely on its own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last update %@ ago. The dryer keeps running safely on its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Aktualisierung vor %@. Der Trockner läuft sicher selbstständig weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière mise à jour il y a %@. Le sécheur continue seul en toute sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última actualización hace %@. El secador sigue funcionando de forma segura por sí solo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر تحديث منذ %@. يواصل المجفف العمل بأمان بمفرده."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終更新：%@前。ドライヤーは単独で安全に動作を続けています。"
          }
        }
      }
    },
