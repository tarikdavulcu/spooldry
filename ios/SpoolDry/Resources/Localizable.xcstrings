    "SpoolDry tracks drying sessions for PLA through PA-CF, with typical guidance for engineering polymers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry tracks drying sessions for PLA through PA-CF, with typical guidance for engineering polymers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry verfolgt Trocknungen von PLA bis PA-CF, mit typischen Richtwerten für technische Kunststoffe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry suit les séchages du PLA au PA-CF, avec des repères typiques pour les polymères techniques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry registra secados de PLA a PA-CF, con pautas típicas para polímeros técnicos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتابع SpoolDry جلسات التجفيف من PLA حتى PA-CF مع إرشادات نموذجية للبوليمرات الهندسية."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDryはPLAからPA-CFまでの乾燥を記録し、エンジニアリングポリマーの一般的な目安を提供します。"
          }
        }
      }
    },
