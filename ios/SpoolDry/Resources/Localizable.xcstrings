    "Your filament is dry. Store it sealed with desiccant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your filament is dry. Store it sealed with desiccant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Filament ist trocken. Lagere es luftdicht mit Trockenmittel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre filament est sec. Stockez-le hermétiquement avec un dessiccant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu filamento está seco. Guárdalo sellado con desecante."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيطك جاف. خزّنه محكم الإغلاق مع مادة مجففة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィラメントは乾燥しました。乾燥剤と一緒に密閉保管してください。"
          }
        }
      }
    },
    "Your iPhone talks directly to the dryer over Bluetooth. No account, no cloud, works offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone talks directly to the dryer over Bluetooth. No account, no cloud, works offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPhone spricht direkt per Bluetooth mit dem Trockner. Kein Konto, keine Cloud, funktioniert offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone communique directement avec le sécheur en Bluetooth. Pas de compte, pas de cloud, fonctionne hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPhone se comunica directamente con el secador por Bluetooth. Sin cuenta, sin nube, funciona sin conexión."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتواصل الـ iPhone مع المجفف مباشرة عبر البلوتوث. بلا حساب ولا سحابة، ويعمل دون اتصال."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneはBluetoothでドライヤーと直接通信します。アカウント不要、クラウドなし、オフラインで動作。"
          }
        }
      }
    },
    "Your own values are labelled as yours, never as a manufacturer recommendation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own values are labelled as yours, never as a manufacturer recommendation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Werte werden als deine gekennzeichnet, nie als Herstellerempfehlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres valeurs sont indiquées comme les vôtres, jamais comme une recommandation du fabricant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus valores se etiquetan como tuyos, nunca como recomendación del fabricante."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُصنَّف قيمك على أنها خاصة بك، وليست توصية من الشركة المصنّعة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で入力した値はユーザー設定として表示され、メーカー推奨とは表示されません。"
          }
        }
      }
    },
    "error.fanFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fan not spinning. Heater switched off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lüfter dreht nicht. Heizung abgeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ventilateur ne tourne pas. Chauffage coupé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ventilador no gira. Calefactor apagado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المروحة لا تدور. أُوقف السخان."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンが回転していません。ヒーターを停止しました。"
          }
        }
      }
    },
    "error.heaterStuckOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat detected while the heater is off. Disconnect power and inspect the MOSFET and relay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wärme trotz ausgeschalteter Heizung. Strom trennen und MOSFET sowie Relais prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaleur détectée chauffage coupé. Débranchez et inspectez le MOSFET et le relais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detecta calor con el calefactor apagado. Desconecta la alimentación y revisa el MOSFET y el relé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُصدت حرارة والسخان متوقف. افصل الطاقة وافحص الـ MOSFET والمرحّل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒーター停止中に発熱を検出。電源を切りMOSFETとリレーを点検してください。"
          }
        }
      }
    },
    "error.heatingIneffective": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heating has no effect. The heater, its wiring or the chamber sensor may be faulty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heizen zeigt keine Wirkung. Heizung, Verdrahtung oder Kammersensor könnten defekt sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chauffage est sans effet. Chauffage, câblage ou capteur peut-être défectueux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calefacción no tiene efecto. El calefactor, el cableado o el sensor pueden fallar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسخين بلا أثر. قد يكون السخان أو توصيله أو حساس الحجرة معطلًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加熱の効果がありません。ヒーター、配線、庫内センサーの故障の可能性があります。"
          }
        }
      }
    },
