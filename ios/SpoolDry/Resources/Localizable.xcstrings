    },
    "error.overTempHeater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heater outlet over-temperature. Check the fan and airflow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertemperatur am Heizungsauslass. Prüfe Lüfter und Luftstrom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surchauffe en sortie de chauffage. Vérifiez le ventilateur et le flux d'air."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobretemperatura en la salida del calefactor. Revisa el ventilador y el flujo de aire."
          }
