          }
        }
      }
    },
    "error.sensorRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Implausible sensor reading. The value was rejected for safety."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplausibler Sensorwert. Der Wert wurde aus Sicherheitsgründen verworfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure du capteur invraisemblable. Valeur rejetée par sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura del sensor no plausible. Se rechazó por seguridad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة حساس غير منطقية. رُفضت القيمة حفاظًا على السلامة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサー値が不自然なため、安全のため破棄しました。"
          }
        }
      }
    },
    "error.sessionTimeLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety time limit reached. Heater switched off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheits-Zeitlimit erreicht. Heizung abgeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de temps de sécurité atteinte. Chauffage coupé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de tiempo de seguridad. Calefactor apagado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
