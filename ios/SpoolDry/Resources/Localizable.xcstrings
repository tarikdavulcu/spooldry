          }
        }
      }
    },
    "error.preheatTimeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target temperature was not reached in time. Check the lid and insulation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieltemperatur nicht rechtzeitig erreicht. Prüfe Deckel und Isolierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Température cible non atteinte à temps. Vérifiez le couvercle et l'isolation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se alcanzó la temperatura a tiempo. Revisa la tapa y el aislamiento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُبلَغ الحرارة المستهدفة في الوقت المحدد. افحص الغطاء والعزل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標温度に時間内に到達しませんでした。フタと断熱を確認してください。"
          }
        }
      }
    },
    "error.sensorCrc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor data corrupted (CRC). Check wiring and interference."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensordaten fehlerhaft (CRC). Prüfe Verdrahtung und Störungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données capteur corrompues (CRC). Vérifiez le câblage et les interférences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos del sensor dañados (CRC). Revisa el cableado y las interferencias."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الحساس تالفة (CRC). افحص التوصيلات والتداخل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサーデータ破損（CRC）。配線とノイズを確認してください。"
          }
        }
      }
    },
    "error.sensorI2c": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature/humidity sensor not responding (I²C). Check the sensor cable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatur-/Feuchtesensor antwortet nicht (I²C). Prüfe das Sensorkabel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capteur température/humidité ne répond pas (I²C). Vérifiez le câble."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sensor de temperatura/humedad no responde (I²C). Revisa el cable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساس الحرارة/الرطوبة لا يستجيب (I²C). افحص كابل الحساس."
          }
        },
        "ja": {
          "stringUnit": {
