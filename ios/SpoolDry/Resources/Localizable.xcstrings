    "Could not read the dryer. Make sure it runs SpoolDry firmware and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the dryer. Make sure it runs SpoolDry firmware and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Trockner konnte nicht gelesen werden. Prüfe, ob die SpoolDry-Firmware läuft, und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le sécheur. Vérifiez qu'il exécute le firmware SpoolDry et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el secador. Comprueba que use el firmware SpoolDry e inténtalo de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة المجفف. تأكد من أنه يعمل ببرنامج SpoolDry الثابت ثم حاول مجددًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライヤーを読み取れませんでした。SpoolDryファームウェアが動作しているか確認して再試行してください。"
          }
        }
      }
    },
