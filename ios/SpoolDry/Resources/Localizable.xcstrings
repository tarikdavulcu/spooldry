    "filament.notes.pva": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water-soluble support. Keep it sealed; moisture makes it soft and sticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasserlösliches Stützmaterial. Luftdicht lagern; Feuchte macht es weich und klebrig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Support soluble dans l'eau. Gardez-le hermétique ; l'humidité le rend mou et collant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soporte soluble en agua. Guárdalo sellado; la humedad lo vuelve blando y pegajoso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعامة ذائبة في الماء. أبقِه محكم الإغلاق؛ فالرطوبة تجعله لينًا ولزجًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水溶性サポート材。湿気で柔らかくベタつくため密閉保管してください。"
          }
        }
      }
    },
    "filament.notes.tpu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible and hygroscopic. Wet TPU strings heavily and foams."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexibel und hygroskopisch. Feuchtes TPU zieht stark Fäden und schäumt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible et hygroscopique. Le TPU humide file beaucoup et mousse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible e higroscópico. El TPU húmedo hace muchos hilos y espuma."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرن ويمتص الرطوبة. TPU الرطب يُخرج خيوطًا كثيرة ويتكوّن فيه رغوة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔軟で吸湿性あり。湿ったTPUはひどく糸を引き、発泡します。"
          }
        }
      }
    },
