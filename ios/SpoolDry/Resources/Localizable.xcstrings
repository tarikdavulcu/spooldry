    "Switch on your ESP32 dryer and keep your iPhone nearby. SpoolDry talks to it directly over Bluetooth. No account, no cloud.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch on your ESP32 dryer and keep your iPhone nearby. SpoolDry talks to it directly over Bluetooth. No account, no cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte deinen ESP32-Trockner ein und halte dein iPhone in der Nähe. SpoolDry spricht direkt per Bluetooth mit ihm. Kein Konto, keine Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allumez votre sécheur ESP32 et gardez votre iPhone à proximité. SpoolDry communique directement en Bluetooth. Pas de compte, pas de cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende tu secador ESP32 y mantén el iPhone cerca. SpoolDry se comunica directamente por Bluetooth. Sin cuenta, sin nube."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل مجفف ESP32 وأبقِ الـ iPhone قريبًا. يتواصل SpoolDry معه مباشرة عبر البلوتوث. بلا حساب ولا سحابة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32ドライヤーの電源を入れ、iPhoneを近くに置いてください。SpoolDryはBluetoothで直接通信します。アカウントもクラウドも不要です。"
          }
        }
      }
    },
