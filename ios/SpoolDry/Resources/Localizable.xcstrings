        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全上の時間制限に達しました。ヒーターを停止しました。"
          }
        }
      }
    },
    "error.unexpectedReset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dryer restarted unexpectedly. The session was stopped for safety."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Trockner wurde unerwartet neu gestartet. Die Trocknung wurde sicherheitshalber beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sécheur a redémarré de façon inattendue. La séance a été arrêtée par sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El secador se reinició inesperadamente. La sesión se detuvo por seguridad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعيد تشغيل المجفف بشكل غير متوقع. أُوقفت الجلسة حفاظًا على السلامة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライヤーが予期せず再起動しました。安全のためセッションを停止しました。"
          }
        }
      }
    },
    "filament.notes.abs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderately hygroscopic. Drying improves layer bonding and surface finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäßig hygroskopisch. Trocknen verbessert Schichthaftung und Oberfläche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modérément hygroscopique. Le séchage améliore l'adhésion des couches et l'aspect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderadamente higroscópico. El secado mejora la adhesión entre capas y el acabado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوسط امتصاص الرطوبة. يحسّن التجفيف التصاق الطبقات وجودة السطح."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸湿性は中程度。乾燥で層間接着と表面品質が向上します。"
          }
        }
      }
    },
    "filament.notes.asa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar to ABS. UV-stable outdoor material that still benefits from drying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnlich wie ABS. UV-beständig für außen, profitiert dennoch vom Trocknen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proche de l'ABS. Résistant aux UV, il profite tout de même du séchage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar al ABS. Resistente a UV para exteriores, también mejora al secarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشابه لـ ABS. مقاوم للأشعة فوق البنفسجية ويستفيد من التجفيف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ABSに近い屋外向けUV耐性素材。乾燥の効果があります。"
          }
        }
      }
    },
    "filament.notes.asa_cf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon-fiber ASA. Dry like ASA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohlefaser-ASA. Wie ASA trocknen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ASA fibre de carbone. Séchez comme l'ASA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ASA con fibra de carbono. Sécalo como el ASA."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ASA بألياف الكربون. جفّفه مثل ASA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーボン入りASA。ASAと同様に乾燥します。"
          }
        }
      }
    },
    "filament.notes.bvoh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water-soluble support. Very sensitive to humidity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasserlösliches Stützmaterial. Sehr feuchteempfindlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Support soluble dans l'eau. Très sensible à l'humidité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soporte soluble en agua. Muy sensible a la humedad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعامة ذائبة في الماء. شديدة الحساسية للرطوبة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水溶性サポート材。湿気に非常に敏感です。"
          }
        }
      }
    },
    "filament.notes.custom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own profile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigenes Profil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre propre profil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio perfil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفك الخاص."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー定義のプロファイル。"
          }
        }
      }
    },
    "filament.notes.pa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nylon absorbs water within hours. Long drying and dry-box printing are essential."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nylon nimmt binnen Stunden Wasser auf. Langes Trocknen und Druck aus der Trockenbox sind Pflicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nylon absorbe l'eau en quelques heures. Séchage long et impression depuis une boîte sèche indispensables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nailon absorbe agua en horas. Secado largo e impresión desde caja seca son esenciales."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمتص النايلون الماء خلال ساعات. التجفيف الطويل والطباعة من صندوق جاف ضروريان."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナイロンは数時間で吸水します。長時間の乾燥とドライボックスからの印刷が不可欠です。"
          }
        }
      }
    },
    "filament.notes.pa_cf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon-fiber nylon: as hygroscopic as PA. Dry long, print from a dry box."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohlefaser-Nylon: so hygroskopisch wie PA. Lange trocknen, aus der Trockenbox drucken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nylon fibre de carbone : aussi hygroscopique que le PA. Séchez longtemps, imprimez depuis une boîte sèche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nailon con fibra de carbono: tan higroscópico como el PA. Seca mucho tiempo e imprime desde caja seca."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نايلون بألياف الكربون: يمتص الرطوبة مثل PA. جفّفه طويلًا واطبع من صندوق جاف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーボン入りナイロン：PAと同等の吸湿性。長時間乾燥し、ドライボックスから印刷してください。"
          }
        }
      }
    },
    "filament.notes.pa_gf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass-fiber nylon: very hygroscopic; manufacturers specify long drying times."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasfaser-Nylon: sehr hygroskopisch; Hersteller nennen lange Trocknungszeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nylon fibre de verre : très hygroscopique ; les fabricants indiquent de longs séchages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nailon con fibra de vidrio: muy higroscópico; los fabricantes indican secados largos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نايلون بألياف الزجاج: شديد الامتصاص؛ يحدد المصنّعون أوقات تجفيف طويلة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラス繊維入りナイロン：吸湿性が非常に高く、メーカーは長時間の乾燥を指定しています。"
          }
        }
      }
    },
    "filament.notes.pc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highly hygroscopic. Wet PC causes bubbles and weak parts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stark hygroskopisch. Feuchtes PC verursacht Blasen und schwache Teile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très hygroscopique. Le PC humide provoque bulles et pièces fragiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy higroscópico. El PC húmedo provoca burbujas y piezas débiles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شديد الامتصاص للرطوبة. PC الرطب يسبب فقاعات وقطعًا ضعيفة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸湿性が高く、湿ったPCは気泡や強度低下を招きます。"
          }
        }
      }
    },
    "filament.notes.pc_cf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon-fiber PC. Highly hygroscopic; manufacturers list 90–120 °C."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohlefaser-PC. Stark hygroskopisch; Hersteller nennen 90–120 °C."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC fibre de carbone. Très hygroscopique ; fabricants : 90–120 °C."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PC con fibra de carbono. Muy higroscópico; los fabricantes indican 90–120 °C."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PC بألياف الكربون. شديد الامتصاص؛ يحدد المصنّعون 90–120 °C."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーボン入りPC。吸湿性が高く、メーカーは90〜120 °Cを指定しています。"
          }
        }
      }
    },
    "filament.notes.peek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-performance polymer that needs 120–150 °C drying, beyond SpoolDry hardware v1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochleistungskunststoff mit 120–150 °C Trocknung, jenseits der SpoolDry-Hardware v1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polymère haute performance à sécher à 120–150 °C, au-delà du matériel SpoolDry v1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Polímero de alto rendimiento que requiere 120–150 °C, fuera del alcance del hardware SpoolDry v1."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بوليمر عالي الأداء يحتاج تجفيفًا عند 120–150 °C، وهو ما يتجاوز عتاد SpoolDry v1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "120〜150 °Cでの乾燥が必要な高性能ポリマー。SpoolDryハードウェアv1の範囲外です。"
          }
        }
      }
    },
    "filament.notes.pei": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ULTEM-class polymer that needs 130–150 °C drying, beyond SpoolDry hardware v1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ULTEM-Kunststoff mit 130–150 °C Trocknung, jenseits der SpoolDry-Hardware v1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polymère type ULTEM à sécher à 130–150 °C, au-delà du matériel SpoolDry v1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Polímero tipo ULTEM que requiere 130–150 °C, fuera del alcance del hardware SpoolDry v1."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بوليمر من فئة ULTEM يحتاج 130–150 °C، وهو ما يتجاوز عتاد SpoolDry v1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "130〜150 °Cでの乾燥が必要なULTEM系ポリマー。SpoolDryハードウェアv1の範囲外です。"
          }
        }
      }
    },
    "filament.notes.petg": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wet PETG strings and pops. Moderate temperatures avoid sticking windings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feuchtes PETG zieht Fäden und knackt. Moderate Temperaturen verhindern verklebte Windungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PETG humide file et crépite. Des températures modérées évitent que les spires collent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PETG húmedo hace hilos y chasquidos. Temperaturas moderadas evitan que las vueltas se peguen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PETG الرطب يُخرج خيوطًا وفرقعات. الحرارة المعتدلة تمنع التصاق اللفات."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "湿ったPETGは糸引きや破裂音が出ます。適度な温度で巻きの固着を防ぎます。"
          }
        }
      }
    },
    "filament.notes.petg_cf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon-fiber PETG. Dry like PETG."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohlefaser-PETG. Wie PETG trocknen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PETG fibre de carbone. Séchez comme le PETG."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PETG con fibra de carbono. Sécalo como el PETG."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PETG بألياف الكربون. جفّفه مثل PETG."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーボン入りPETG。PETGと同様に乾燥します。"
          }
        }
      }
    },
    "filament.notes.pla": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most forgiving material. Dry when prints string or the surface turns rough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am unkompliziertesten. Trocknen, wenn Fäden ziehen oder die Oberfläche rau wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus tolérant. Séchez si des fils apparaissent ou si la surface devient rugueuse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material más tolerante. Sécalo si aparecen hilos o la superficie se vuelve rugosa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكثر المواد تسامحًا. جفّفه عند ظهور الخيوط أو خشونة السطح."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も扱いやすい素材。糸引きや表面の荒れが出たら乾燥してください。"
          }
        }
      }
    },
    "filament.notes.pla_cf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon-fiber PLA. Dry like PLA; keep temperatures low."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohlefaser-PLA. Wie PLA trocknen; Temperaturen niedrig halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PLA fibre de carbone. Séchez comme le PLA, à basse température."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PLA con fibra de carbono. Sécalo como el PLA, a baja temperatura."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PLA بألياف الكربون. جفّفه مثل PLA بحرارة منخفضة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーボン入りPLA。PLAと同様に低めの温度で乾燥します。"
          }
        }
      }
    },
    "filament.notes.pps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemically resistant polymer that needs 110–140 °C drying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemikalienbeständiger Kunststoff mit 110–140 °C Trocknung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polymère résistant aux produits chimiques, à sécher à 110–140 °C."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Polímero resistente a químicos que requiere 110–140 °C."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بوليمر مقاوم للكيماويات يحتاج تجفيفًا عند 110–140 °C."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "110〜140 °Cでの乾燥が必要な耐薬品性ポリマー。"
          }
        }
      }
    },
    "filament.notes.pps_cf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiber-filled PPS that needs 110–140 °C drying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasergefülltes PPS mit 110–140 °C Trocknung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PPS chargé en fibres, à sécher à 110–140 °C."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PPS con fibra que requiere 110–140 °C."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PPS مدعّم بالألياف يحتاج تجفيفًا عند 110–140 °C."
          }
        },
