          "stringUnit": {
            "state": "translated",
            "value": "Typische Werte liegen über SpoolDrys 70-°C-Grenze: länger bei 70 °C trocknen oder stärkeren Trockner nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les repères dépassent la limite de 70 °C de SpoolDry : séchez plus longtemps à 70 °C ou utilisez un sécheur plus puissant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pautas superan el límite de 70 °C de SpoolDry: seca más tiempo a 70 °C o usa un secador más potente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإرشادات تتجاوز حد SpoolDry البالغ 70 °C: جفّف لمدة أطول عند 70 °C أو استخدم مجففًا أعلى تصنيفًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的な目安はSpoolDryの上限70 °Cを超えます。70 °Cで長めに乾燥するか、高温対応のドライヤーを使用してください。"
          }
        }
      }
    },
    "warning.highTempDryerRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires 110–150 °C. SpoolDry hardware v1 (max 70 °C) cannot fully dry this material; use a vacuum oven or industrial dryer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt 110–150 °C. SpoolDry-Hardware v1 (max. 70 °C) kann dieses Material nicht vollständig trocknen; Vakuumofen oder Industrietrockner verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite 110–150 °C. Le matériel SpoolDry v1 (70 °C max) ne peut pas sécher complètement ce matériau ; utilisez une étuve sous vide ou un sécheur industriel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere 110–150 °C. El hardware SpoolDry v1 (máx. 70 °C) no puede secarlo por completo; usa un horno de vacío o un secador industrial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب 110–150 °C. عتاد SpoolDry v1 (بحد أقصى 70 °C) لا يجفف هذه المادة بالكامل؛ استخدم فرنًا مفرغًا أو مجففًا صناعيًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "110〜150 °Cが必要です。SpoolDryハードウェアv1（最高70 °C）では完全に乾燥できません。真空オーブンや産業用ドライヤーを使用してください。"
          }
        }
      }
    },
    "warning.lowGlassTransition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not exceed about 55–60 °C: PLA softens and spools can deform."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht über ca. 55–60 °C: PLA erweicht und Spulen können sich verformen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne dépassez pas 55–60 °C environ : le PLA ramollit et les bobines peuvent se déformer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No superes unos 55–60 °C: el PLA se ablanda y las bobinas pueden deformarse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتجاوز نحو 55–60 °C: يلين PLA وقد تتشوه البكرات."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約55〜60 °Cを超えないでください。PLAが軟化しスプールが変形することがあります。"
          }
        }
      }
    },
    "warning.printFromDryBox": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Print directly from a dry box; it re-absorbs moisture within hours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt aus einer Trockenbox drucken; nimmt binnen Stunden wieder Feuchte auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimez depuis une boîte sèche ; il réabsorbe l'humidité en quelques heures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime desde una caja seca; vuelve a absorber humedad en horas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطبع مباشرة من صندوق جاف؛ إذ يعيد امتصاص الرطوبة خلال ساعات."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライボックスから直接印刷してください。数時間で再吸湿します。"
          }
        }
      }
    },
    "warning.storeSealed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorbs moisture quickly: store sealed with desiccant right after drying."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt schnell Feuchte auf: direkt nach dem Trocknen luftdicht mit Trockenmittel lagern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorbe vite l'humidité : stockez hermétiquement avec dessiccant dès le séchage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Absorbe humedad rápido: guárdalo sellado con desecante justo después de secar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمتص الرطوبة بسرعة: خزّنه محكمًا مع مادة مجففة فور التجفيف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吸湿が速いため、乾燥後すぐに乾燥剤と密閉保管してください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
