    },
    "SpoolDry hardware is a DIY/hobby project and is not certified. Never bypass the thermal fuse or thermostat, and do not leave a prototype unattended.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry hardware is a DIY/hobby project and is not certified. Never bypass the thermal fuse or thermostat, and do not leave a prototype unattended."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SpoolDry-Hardware ist ein DIY-/Hobbyprojekt und nicht zertifiziert. Überbrücke niemals Thermosicherung oder Thermostat und lass einen Prototyp nicht unbeaufsichtigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel SpoolDry est un projet DIY/amateur non certifié. Ne contournez jamais le fusible thermique ni le thermostat, et ne laissez pas un prototype sans surveillance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hardware SpoolDry es un proyecto DIY/aficionado y no está certificado. Nunca puentees el fusible térmico ni el termostato, y no dejes un prototipo sin vigilancia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عتاد SpoolDry مشروع هواة/صنع ذاتي وغير معتمد. لا تتجاوز أبدًا المصهر الحراري أو الترموستات، ولا تترك نموذجًا أوليًا دون مراقبة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDryハードウェアはDIY/ホビー向けで認証品ではありません。温度ヒューズやサーモスタットを絶対にバイパスせず、試作機を放置しないでください。"
          }
        }
      }
    },
    "SpoolDry needs Bluetooth permission to talk to your dryer. Enable it in Settings > SpoolDry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry needs Bluetooth permission to talk to your dryer. Enable it in Settings > SpoolDry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry braucht Bluetooth-Zugriff, um mit deinem Trockner zu sprechen. Aktiviere ihn unter Einstellungen > SpoolDry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry a besoin de l'accès Bluetooth pour communiquer avec votre sécheur. Activez-le dans Réglages > SpoolDry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry necesita permiso de Bluetooth para hablar con tu secador. Actívalo en Ajustes > SpoolDry."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج SpoolDry إلى إذن البلوتوث للتواصل مع مجففك. فعّله من الإعدادات > SpoolDry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライヤーと通信するにはBluetoothの許可が必要です。設定 > SpoolDry で有効にしてください。"
          }
        }
      }
    },
    "SpoolDry starting point": {
