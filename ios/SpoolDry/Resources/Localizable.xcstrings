    "Values are typical starting guidance compiled from manufacturer recommendations, not universal requirements. Your filament's data sheet always wins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are typical starting guidance compiled from manufacturer recommendations, not universal requirements. Your filament's data sheet always wins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte sind typische Startwerte aus Herstellerempfehlungen, keine allgemeingültigen Vorgaben. Das Datenblatt deines Filaments hat immer Vorrang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont des repères typiques compilés à partir des recommandations des fabricants, pas des exigences universelles. La fiche technique de votre filament prime toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores son pautas iniciales típicas basadas en recomendaciones de fabricantes, no requisitos universales. La ficha técnica de tu filamento siempre manda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيم إرشادات بداية نموذجية مجمّعة من توصيات المصنّعين وليست متطلبات عامة. ورقة بيانات خيطك هي المرجع دائمًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はメーカー推奨をまとめた一般的な初期目安で、普遍的な要件ではありません。常にフィラメントのデータシートが優先です。"
          }
        }
      }
    },
