    "Firmware 1.0 is updated over USB. Wireless (BLE OTA) updates are prepared in the firmware layout but not available yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware 1.0 is updated over USB. Wireless (BLE OTA) updates are prepared in the firmware layout but not available yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware 1.0 wird per USB aktualisiert. Drahtlose Updates (BLE OTA) sind im Speicherlayout vorbereitet, aber noch nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le firmware 1.0 se met à jour par USB. Les mises à jour sans fil (BLE OTA) sont prévues dans l'organisation mémoire mais pas encore disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware 1.0 se actualiza por USB. Las actualizaciones inalámbricas (BLE OTA) están preparadas en la memoria pero aún no disponibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحدَّث البرنامج الثابت 1.0 عبر USB. التحديثات اللاسلكية (BLE OTA) مُهيأة في تخطيط الذاكرة لكنها غير متاحة بعد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファームウェア1.0はUSBで更新します。ワイヤレス更新（BLE OTA）はメモリ構成で準備済みですが、まだ利用できません。"
          }
        }
      }
    },
