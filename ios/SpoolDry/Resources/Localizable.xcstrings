    "Pairing required. Accept the Bluetooth pairing request. New phones can pair within 5 minutes after the dryer is switched on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing required. Accept the Bluetooth pairing request. New phones can pair within 5 minutes after the dryer is switched on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplung erforderlich. Bestätige die Bluetooth-Kopplungsanfrage. Neue Telefone können innerhalb von 5 Minuten nach dem Einschalten koppeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelage requis. Acceptez la demande de jumelage Bluetooth. Un nouveau téléphone peut se jumeler dans les 5 minutes suivant l'allumage du sécheur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere emparejar. Acepta la solicitud de emparejamiento Bluetooth. Los teléfonos nuevos pueden emparejarse durante 5 minutos tras encender el secador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الاقتران. اقبل طلب اقتران البلوتوث. يمكن للهواتف الجديدة الاقتران خلال 5 دقائق من تشغيل المجفف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングが必要です。Bluetoothのペアリング要求を許可してください。新しいiPhoneはドライヤーの電源投入後5分以内にペアリングできます。"
          }
        }
      }
    },
    "Pairing: the first command asks iOS to pair with the dryer. New phones can pair within 5 minutes after the dryer is switched on (or after holding its BOOT button for 10 seconds).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing: the first command asks iOS to pair with the dryer. New phones can pair within 5 minutes after the dryer is switched on (or after holding its BOOT button for 10 seconds)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplung: Der erste Befehl fordert iOS zur Kopplung auf. Neue Telefone können innerhalb von 5 Minuten nach dem Einschalten koppeln (oder nachdem die BOOT-Taste 10 Sekunden gehalten wurde)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelage : la première commande demande à iOS de se jumeler. Un nouveau téléphone peut se jumeler dans les 5 minutes suivant l'allumage (ou après un appui de 10 secondes sur BOOT)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparejamiento: el primer comando pide a iOS emparejarse. Los teléfonos nuevos pueden emparejarse durante 5 minutos tras encender el secador (o tras mantener el botón BOOT 10 segundos)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاقتران: يطلب الأمر الأول من iOS الاقتران بالمجفف. يمكن للهواتف الجديدة الاقتران خلال 5 دقائق من التشغيل (أو بعد الضغط على زر BOOT لمدة 10 ثوانٍ)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング：最初のコマンドでiOSがペアリングを求めます。新しいiPhoneは電源投入後5分以内（またはBOOTボタンを10秒長押し後）にペアリングできます。"
          }
        }
      }
    },
    "Payment is charged to your Apple Account. One purchase unlocks SpoolDry on this Apple Account; there are no recurring charges.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple Account. One purchase unlocks SpoolDry on this Apple Account; there are no recurring charges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung erfolgt über deinen Apple Account. Ein Kauf schaltet SpoolDry für diesen Apple Account frei; es gibt keine wiederkehrenden Kosten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de votre compte Apple. Un achat débloque SpoolDry pour ce compte Apple ; aucun frais récurrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu cuenta de Apple. Una compra desbloquea SpoolDry en esta cuenta de Apple; no hay cargos recurrentes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخصم المبلغ من حساب Apple الخاص بك. شراء واحد يفتح SpoolDry لهذا الحساب، بلا رسوم متكررة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いはApple Accountに請求されます。1回の購入でこのApple AccountのSpoolDryが解除され、継続課金はありません。"
          }
        }
      }
    },
