    "Last update %@ ago. The dryer keeps running safely on its own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last update %@ ago. The dryer keeps running safely on its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Aktualisierung vor %@. Der Trockner läuft sicher selbstständig weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière mise à jour il y a %@. Le sécheur continue seul en toute sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última actualización hace %@. El secador sigue funcionando de forma segura por sí solo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر تحديث منذ %@. يواصل المجفف العمل بأمان بمفرده."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終更新：%@前。ドライヤーは単独で安全に動作を続けています。"
          }
        }
      }
    },
    "Limits come from your dryer: %@ to %@. The fan always runs while heating.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits come from your dryer: %@ to %@. The fan always runs while heating."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Grenzen kommen von deinem Trockner: %@ bis %@. Beim Heizen läuft der Lüfter immer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites fournies par votre sécheur : %@ à %@. Le ventilateur tourne toujours pendant la chauffe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites los fija tu secador: de %@ a %@. El ventilador siempre funciona al calentar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحدود يحددها مجففك: من %@ إلى %@. تعمل المروحة دائمًا أثناء التسخين."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限と下限はドライヤーから取得：%@〜%@。加熱中は常にファンが回ります。"
          }
        }
      }
    },
    "Live Activities and notifications show only what your dryer reported over Bluetooth. If the iPhone is out of range, the dryer keeps running safely and SpoolDry catches up on reconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities and notifications show only what your dryer reported over Bluetooth. If the iPhone is out of range, the dryer keeps running safely and SpoolDry catches up on reconnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten und Mitteilungen zeigen nur, was dein Trockner per Bluetooth gemeldet hat. Ist das iPhone außer Reichweite, läuft der Trockner sicher weiter und SpoolDry holt beim erneuten Verbinden auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct et notifications n'affichent que ce que le sécheur a transmis en Bluetooth. Hors de portée, le sécheur continue en toute sécurité et SpoolDry se met à jour à la reconnexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Actividades en vivo y notificaciones solo muestran lo que el secador informó por Bluetooth. Fuera de alcance, el secador sigue funcionando de forma segura y SpoolDry se actualiza al reconectar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الأنشطة المباشرة والإشعارات ما أبلغ عنه المجفف عبر البلوتوث فقط. إذا ابتعد الـ iPhone يواصل المجفف العمل بأمان ويتزامن SpoolDry عند إعادة الاتصال."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティと通知は、ドライヤーがBluetoothで報告した内容のみを表示します。iPhoneが圏外でもドライヤーは安全に動作し続け、再接続時にSpoolDryが同期します。"
          }
        }
      }
    },
    "Live Activities and the Dynamic Island show the real dryer state and remaining time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities and the Dynamic Island show the real dryer state and remaining time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten und Dynamic Island zeigen den echten Trocknerstatus und die Restzeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct et la Dynamic Island affichent l'état réel et le temps restant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Actividades en vivo y la Dynamic Island muestran el estado real y el tiempo restante."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الأنشطة المباشرة والجزيرة الديناميكية حالة المجفف الفعلية والوقت المتبقي."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティとDynamic Islandに実際の状態と残り時間を表示。"
          }
        }
      }
    },
