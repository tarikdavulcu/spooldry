{
  "sourceLanguage": "en",
  "strings": {
    "%@ is dry. %@ is cooling down or finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is dry. %@ is cooling down or finished."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist trocken. %2$@ kühlt ab oder ist fertig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est sec. %2$@ refroidit ou a terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está seco. %2$@ se está enfriando o ha terminado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@ جاف. %2$@ يبرد الآن أو انتهى."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の乾燥が完了しました。%2$@ は冷却中または終了しています。"
          }
        }
      }
    },
    "%@ switched the heater off. Check the dryer before restarting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ switched the heater off. Check the dryer before restarting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Heizung abgeschaltet. Prüfe den Trockner vor dem Neustart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a coupé le chauffage. Vérifiez le sécheur avant de redémarrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apagó el calefactor. Revisa el secador antes de reiniciar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف %@ السخان. افحص المجفف قبل إعادة التشغيل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がヒーターを停止しました。再開する前にドライヤーを点検してください。"
          }
        }
      }
    },
