    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry uses Bluetooth to connect directly to your SpoolDry filament dryer and to read the Bluetooth hygrometers in your filament dry boxes. No data leaves your iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry nutzt Bluetooth, um sich direkt mit deinem SpoolDry-Filamenttrockner zu verbinden und die Bluetooth-Hygrometer in deinen Filament-Trockenboxen zu lesen. Keine Daten verlassen dein iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry utilise le Bluetooth pour se connecter directement à votre sécheur de filament SpoolDry et lire les hygromètres Bluetooth de vos boîtes sèches. Aucune donnée ne quitte votre iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDry usa Bluetooth para conectarse directamente a tu secador de filamento SpoolDry y leer los higrómetros Bluetooth de tus cajas secas. Ningún dato sale de tu iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم SpoolDry البلوتوث للاتصال مباشرة بمجفف الخيوط SpoolDry ولقراءة مقاييس الرطوبة بالبلوتوث في صناديق تخزين الخيوط. لا تغادر أي بيانات جهاز iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpoolDryはBluetoothでSpoolDryフィラメントドライヤーに直接接続し、ドライボックス内のBluetooth湿度計を読み取ります。データがiPhoneの外に送信されることはありません。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
